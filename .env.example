# Local PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plinthly_dev

# Database connection (local Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plinthly_dev

# Authentication & Loopback Demo Trust Model
# IMPORTANT: In production, client-supplied actor headers are rejected and fail closed.
# Set AUTH_MODE=local_demo and ENABLE_LOCAL_DEMO_AUTH=true ONLY for local loopback development.
AUTH_MODE=local_demo
ENABLE_LOCAL_DEMO_AUTH=true
APP_BASE_URL=http://127.0.0.1:3001

# PayPal Sandbox (server-side only; never expose to the browser)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Natural-Language Decomposer (Gemini API)
# Decomposes buyer natural-language prompts into structured candidate requirements.
# Gemini does NOT make purchasing or approval decisions; policy evaluation is purely deterministic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Product Discovery (Channel3 API - Optional)
# Discovers live product listings from retailer catalogs.
# Note: Channel3 does not provide destination-specific shipping rates; live candidates
# will fail closed under policy until authoritative carrier quotes are integrated.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# Retailer Shipping Quote Adapters (Feasibility / Partner Boundaries)
# When credentials are absent, both adapters report an explicit 'unavailable' blocker;
# they NEVER infer free shipping.
# Best Buy Commerce API (CAPI) requires enterprise sales-gated partner credentials:
BESTBUY_COMMERCE_API_KEY=
BESTBUY_API_BASE_URL=https://api.bestbuy.com/v1

# Shopify Storefront API requires a configured merchant shop domain and Storefront Access Token:
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Production Judge / Evaluator Access (Secure Bearer / Session Gate)
# In production (NODE_ENV=production), untrusted client headers fail closed.
# Set JUDGE_ACCESS_SECRET to allow authorized evaluators to access the app safely.
JUDGE_ACCESS_SECRET=

